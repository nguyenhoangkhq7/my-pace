POSTGRES_USER=my_pace
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=my_pace_db
DB_HOST=db
DB_PORT=5432


# Generate a strong 256-bit or 512-bit HS512 secret key
JWT_SECRET=your_jwt_secret_key_here

# Resend API Key for sending OTP emails
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Groq API Key for quick-add parsing
GROQ_API_KEY=your_groq_api_key_here
# Groq model for quick-add parsing
GROQ_MODEL=llama-3.1-8b-instant

# Spring DataSource and Redis configurations for Docker Compose
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/my_pace_db
SPRING_DATASOURCE_USERNAME=my_pace
SPRING_DATASOURCE_PASSWORD=your_postgres_password

SPRING_JPA_HIBERNATE_DDL_AUTO=update
